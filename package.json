{
  "name": "vigia",
  "version": "0.1.0",
  "private": true,
  "description": "Verified, dated facts about npm and PyPI packages for AI agents: what breaks between versions, per-version vulnerabilities, compatible versions. REST + MCP.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start:api": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "migrate": "node dist/migrate.js",
    "dev:api": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@renovatebot/pep440": "^4.2.4",
    "hono": "^4.13.10",
    "npm-high-impact": "^1.13.0",
    "pg": "^8.23.0",
    "semver": "^7.8.5",
    "ts-api": "npm:typescript@^5.9.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/semver": "^7.8.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/MatiasDelosSantos/vigia.git"
  },
  "homepage": "https://vigia.coredls.cloud",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "npm",
    "pypi",
    "breaking-changes",
    "dependencies",
    "semver",
    "typescript",
    "osv"
  ]
}
